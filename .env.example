# ---- LLM (OpenAI 호환이면 무엇이든) ----
# OpenAI:        LLM_BASE_URL 비움, LLM_API_KEY=sk-..., LLM_MODEL=gpt-4o-mini
# Gemini:        LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.0-flash
# Ollama(로컬):  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MODEL_SMALL=gpt-4o-mini
# 무료 티어(분당 10~15회)면 호출 간 최소 간격(초). 유료면 0
LLM_MIN_INTERVAL=6
# temperature 미지원 모델이면 1 (모델명이 gpt-5로 시작하면 자동으로 생략). Ollama·Gemini는 0
LLM_FIXED_TEMPERATURE=0
# 제공사 비교 실험용(선택): providers.yaml 참조
OLLAMA_KEY=ollama
# OPENAI_API_KEY=sk-...

# ---- 심판(역분류·관련성 판정) 전용 — 비우면 LLM_* 사용 ----
# 생성(Gemini)과 다른 제공사로 두는 것을 권장. 로컬 Ollama면:
JUDGE_BASE_URL=http://localhost:11434/v1
JUDGE_API_KEY=ollama
JUDGE_MODEL=qwen2.5:7b
JUDGE_MIN_INTERVAL=0

# ---- 임베딩 (로컬, 무료) ----
# 다운로드 2GB 부담되면 intfloat/multilingual-e5-small (접두어는 코드가 자동 처리)
EMBED_MODEL=BAAI/bge-m3

# ---- 벡터 DB ----
# 비우면 ./.qdrant 로컬 파일 모드 (Docker 불필요). Docker 쓰면 http://localhost:6333
QDRANT_URL=

DOMAIN=manufacturing
# 문서 표현 실험: full(기본) | symptom_only (컬렉션명에 모드가 붙으므로 바꾸면 python -m rag.index 재실행)
DOC_TEXT_MODE=full
TOP_K=5
