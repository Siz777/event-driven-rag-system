# ---- LLM (OpenAI 호환이면 무엇이든) ----
# OpenAI:        LLM_BASE_URL 비움, LLM_API_KEY=sk-..., LLM_MODEL=gpt-4o-mini
# Gemini:        LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.0-flash
# Ollama(로컬):  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MODEL_SMALL=gpt-4o-mini
# 무료 티어(분당 10~15회)면 호출 간 최소 간격(초). 유료면 0
LLM_MIN_INTERVAL=6
# temperature 미지원 모델이면 1 (모델명이 gpt-5로 시작하면 자동으로 생략). Ollama·Gemini는 0
LLM_FIXED_TEMPERATURE=0
# 제공사 비교 실험용(선택): providers.yaml 참조
OLLAMA_KEY=ollama
# OPENAI_API_KEY=sk-...

# ---- 심판(역분류·관련성 판정) 전용 — 비우면 LLM_* 사용 ----
# 생성(Gemini)과 다른 제공사로 두는 것을 권장. 로컬 Ollama면:
JUDGE_BASE_URL=http://localhost:11434/v1
JUDGE_API_KEY=ollama
JUDGE_MODEL=qwen2.5:7b
JUDGE_MIN_INTERVAL=0

# ---- 임베딩 (로컬, 무료) ----
# 다운로드 2GB 부담되면 intfloat/multilingual-e5-small (접두어는 코드가 자동 처리)
EMBED_MODEL=BAAI/bge-m3

# ---- 벡터 DB ----
# 비우면 ./.qdrant 로컬 파일 모드 (Docker 불필요). Docker 쓰면 http://localhost:6333
QDRANT_URL=

DOMAIN=manufacturing
# 문서 표현 실험: full(기본) | symptom_only (컬렉션명에 모드가 붙으므로 바꾸면 python -m rag.index 재실행)
DOC_TEXT_MODE=full
TOP_K=5

# ---- 2주차: Slack ----
# Slack 앱 Basic Information > Signing Secret. 웹훅 서명 검증용(없으면 POST /events가 503)
SLACK_SIGNING_SECRET=
# Socket Mode 어댑터(python -m adapters.slack_main / compose slack 서비스). OAuth > Bot Token(xoxb-), Basic Information > App-Level Token(xapp-, connections:write)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# 질문을 받을 채널 ID 허용 목록(쉼표). 비우면 봇이 초대된 모든 채널·DM
SLACK_ALLOWED_CHANNELS=

# ---- 2주차: RabbitMQ (docker compose up -d rabbitmq) ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_MGMT_URL=http://guest:guest@localhost:15672
# 멱등성 가드(docker compose up -d redis). 비우거나 연결 실패면 가드 없이 처리(WARNING)
REDIS_URL=redis://localhost:6379/0

# ---- 2주차: 파이프라인·워커 ----
# 검색 최고 점수가 이보다 낮으면 LLM 호출 없이 no_match (쓰레기 걸러내기용. 관련성 판정은 3주차 LLM 게이팅)
MIN_SCORE=0.45
# LLM 요청 1회 타임아웃(초). 넘으면 워커가 retry 티어로 보냄
LLM_TIMEOUT=90
# SIGTERM 뒤 처리 중 1건을 기다리는 최대 시간(초)
WORKER_DRAIN_TIMEOUT=120
