# Slack 어댑터: Socket Mode 수신(→ ai_tasks) + ai_results 소비(→ 스레드 답글). 임베딩·LLM 의존성 없음
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 SLACK_READY_FILE=/tmp/slack-ready
WORKDIR /app
COPY requirements-slack.txt .
RUN pip install --no-cache-dir -r requirements-slack.txt
COPY events/ events/
COPY mq/ mq/
COPY api/ api/
COPY adapters/ adapters/
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=5 \
  CMD ["test", "-f", "/tmp/slack-ready"]
# exec form: SIGTERM이 python에 닿아야 Socket 연결을 닫고 답글 소비자를 정리한다 (compose init: true)
CMD ["python", "-m", "adapters.slack_main"]
